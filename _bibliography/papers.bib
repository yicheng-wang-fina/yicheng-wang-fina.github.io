@article{investor_demand_elasticity,
  abbr={},
  status={working},
  title={When Firms Respond: Investor Demand Elasticity and Capital Misallocation},
  author={Wang, Yicheng},
  abstract={Investor demand elasticity shapes how much stock prices move when demand shifts, and whether those moves distort real investment. I study how firms' endogenous responses to demand shocks affect the measurement of the elasticity and capital misallocation. Empirically, a one-standard-deviation demand shock from mutual fund flows raises stock prices by 1.9%, and firms respond by issuing equity, raising investment, and paying down debt. This issuance absorbs part of the demand-driven price pressure, and investing the proceeds raises the firm's fundamental value but can also misallocate capital. I estimate a dynamic equilibrium model on these responses and find three results. First, standard estimates count the change in fundamental value, 17% of the initial price response, as price pressure, and so understate the average demand elasticity. Second, no single elasticity is enough: how investors and firms respond depends on the source of the price change, the size of the shock, and the state of the firm. Third, even after this correction, demand remains far from perfectly elastic, yet demand shocks misallocate little capital: eliminating price pressure entirely raises aggregate TFP by less than a modest reduction in real capital adjustment costs. The same source-, size-, and state-dependent responses also limit this misallocation.
},
  journal={Working Paper},
  volume={},
  issue={},
  pages={},
  numpages={0},
  year={2026},
  month={October},
  url={},
  pdf={elasticity.pdf},
  html={https://papers.ssrn.com/abstract=5406384},
  selected={true},
  note={2025 FMA Best Paper Award, Semifinalist},
  previous_title={Estimating Investor Demand Elasticity with Endogenous Firm Responses}
}

@article{mp_diagnostic_expectation,
  abbr={},
  status={working},
  title={Monetary Policy, Diagnostic Expectations, and Customer Capital},
  author={Chen, Yuchen and Wang, Yicheng},
  abstract={We study whether financial markets shape firms' pricing behavior and, through this channel, the transmission of macroeconomic shocks into inflation. We develop a novel measure of firm-product markup premiums using granular retail scanner data that isolates firms' pricing decisions from common demand and cost shocks and applies consistently to public and private firms. We show that exposure to public markets changes pricing behavior: firms increase markup premiums following an IPO, and public firms raise markups and consumer prices significantly more than matched private firms during the 2021--2022 inflation surge, contributing roughly one percentage point to cumulative inflation. These differences are strongest among firms facing greater investor pressure and stronger equity-based managerial incentives. A Bayesian learning model rationalizes these patterns through the information and incentives generated by public markets. Our findings highlight a new channel through which financial markets may amplify inflation.},
  journal={Working Paper},
  volume={},
  issue={},
  pages={},
  numpages={0},
  year={2025},
  month={April},
  url={},
  html={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5180297},
  selected={true}
}

