@article{investor_demand_elasticity,
  abbr={},
  status={working},
  title={Estimating Investor Demand Elasticity with Endogenous Firm Responses},
  author={Wang, Yicheng},
  abstract={I study how firms' endogenous responses to demand shocks affect the measurement of investor demand elasticity and capital misallocation. When a demand shock raises a firm's stock price, the firm responds by issuing equity and using the proceeds to invest and pay down debt. These responses raise fundamental value, creating a feedback from investor demand to fundamentals, while the new shares absorb part of the price pressure. The observed price response therefore blends price pressure with fundamental improvement, which the data alone cannot separate. Empirically, a one-standard-deviation mutual fund flow shock raises stock prices by 1.9% and leads firms to issue equity, invest, and pay down debt. A dynamic equilibrium model matched to these responses attributes 17% of the initial price increase to fundamental improvement and the rest to price pressure. Standard estimates treat this improvement as price pressure; correcting for it raises the elasticity from 1.3 to 1.6. Even corrected, demand is far from perfectly elastic, so price pressure should give firms ample incentive to over- or under-invest. Yet eliminating price pressure entirely raises aggregate TFP by only 0.12%, less than the 0.14% from a modest reduction in real capital adjustment costs. Misallocation stays small because the elasticity is source-, size-, and state-dependent. Source- and size-dependence cap how much price pressure a demand shock creates. State-dependence lets firms short of capital use the remaining pressure as cheap financing, offsetting part of the misallocation it causes.
},
  journal={Working Paper},
  volume={},
  issue={},
  pages={},
  numpages={0},
  year={2026},
  month={August},
  url={},
  pdf={elasticity.pdf},
  html={https://papers.ssrn.com/abstract=5406384},
  selected={true},
  note={2025 FMA Best Paper Award, Semifinalist}
}

@article{mp_diagnostic_expectation,
  abbr={},
  status={working},
  title={Monetary Policy, Diagnostic Expectations, and Customer Capital},
  author={Chen, Yuchen and Wang, Yicheng},
  abstract={We study whether financial markets shape firms' pricing behavior and, through this channel, the transmission of macroeconomic shocks into inflation. We develop a novel measure of firm-product markup premiums using granular retail scanner data that isolates firms' pricing decisions from common demand and cost shocks and applies consistently to public and private firms. We show that exposure to public markets changes pricing behavior: firms increase markup premiums following an IPO, and public firms raise markups and consumer prices significantly more than matched private firms during the 2021--2022 inflation surge, contributing roughly one percentage point to cumulative inflation. These differences are strongest among firms facing greater investor pressure and stronger equity-based managerial incentives. A Bayesian learning model rationalizes these patterns through the information and incentives generated by public markets. Our findings highlight a new channel through which financial markets may amplify inflation.},
  journal={Working Paper},
  volume={},
  issue={},
  pages={},
  numpages={0},
  year={2025},
  month={April},
  url={},
  html={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5180297},
  selected={true}
}

@article{granular_markup_inflation,
  abbr={},
  status={working},
  title={Granular Markups and Inflation Surge: The Role of Managerial Incentives},
  author={Chen, Yuchen and Salomao, Juliana and Sharma, Varun and Wang, Yicheng},
  abstract={We develop a novel methodology to estimate firm-specific markup premiums using highly granular product-level data that controls for common shocks, isolating the premium as a residual. We validate this measure by comparing it to existing accountingbased estimates and by showing that it exhibits expected correlations with firm size and market share. Unlike traditional approaches, our method can be applied to both public and private firms, enabling an analysis of how financial structure and managerial incentives influence pricing decisions. We find that financial structure matters: public firms systematically increase markups following an IPO. Moreover, during the 2021-2022 inflation surge, publicly listed firms expanded their margins by capitalizing on inflationary pressures-especially among firms with high retail ownership, large early-pandemic stock declines, and strong equity-based pay incentives.},
  journal={Working Paper},
  volume={},
  issue={},
  pages={},
  numpages={0},
  year={2025},
  month={May},
  url={},
  html={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5369179},
  selected={true}
}

